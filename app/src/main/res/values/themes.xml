<resources>
    <style name="Theme.Nabra" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/nabra_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="Theme.Nabra.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/nabra_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash</item>
        <item name="postSplashScreenTheme">@style/Theme.Nabra</item>
    </style>
</resources>
